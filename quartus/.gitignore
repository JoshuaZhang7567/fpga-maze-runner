# Keep: fpga-maze-runner.qpf, fpga-maze-runner.qsf, DE1_SoC.qsf (and any .sdc you add)
# Everything below is regenerated by Quartus on each computer

# Compile databases (machine-specific, and they break when the Quartus version differs)
db/
incremental_db/
qdb/
tmp-clearbox/
greybox_tmp/
hc_output/

# Compile output: reports, .sof, and the Programmer .cdf (holds an absolute path)
output_files/

# Netlists made for simulation by EDA Netlist Writer
simulation/

# Window layout of the Quartus GUI
*.qws

# Small files Quartus writes during compiles
c5_pin_model_dump.txt
PLLJ_PLLSPE_INFO.txt
*_assignment_defaults.qdf
*.qarlog
*.bak
