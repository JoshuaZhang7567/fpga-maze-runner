# ---------------------------------------------------------------
# Quartus project files
# The .qpf (project) and .qsf (settings + pin assignments) ARE
# committed, so a fresh clone opens and compiles as-is.
# Only per-user workspace / defaults files are ignored.
# ---------------------------------------------------------------
*.qws
*_assignment_defaults.qdf

# ---------------------------------------------------------------
# Quartus build output
# ---------------------------------------------------------------
db/
incremental_db/
output_files/
qdb/
tmp-clearbox/
greybox_tmp/
hc_output/
.qsys_edit/
*.rpt
*.summary
*.smsg
*.done
*.jdi
*.pin
*.pof
*.sof
*.rbf
*.sld
*.cdf
*.map
*.qarlog
*.qar
c5_pin_model_dump.txt
PLLJ_PLLSPE_INFO.txt

# ---------------------------------------------------------------
# Platform Designer / IP Catalog
# The generated synthesis output (ps2_ip/synthesis/, incl. the .qip)
# IS committed so a fresh clone compiles without "Generate HDL".
# If you change ps2_ip.qsys, regenerate and commit the new output.
# ---------------------------------------------------------------
*.sopcinfo
*_generation.rpt

# ---------------------------------------------------------------
# Simulation (ModelSim / Questa / Icarus)
# ---------------------------------------------------------------
work/
simulation/
transcript
*.wlf
vsim.wlf
*.vcd
*.vvp
modelsim.ini
*.mpf
*.cr.mti

